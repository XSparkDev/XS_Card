# Copy this file to keystore.properties (same folder: android/).
# Put your Play UPLOAD keystore at app/play-upload.keystore (matches SHA1 shown in Play Console).
#
# Verify SHA1 before uploading:
#   keytool -list -v -keystore app/play-upload.keystore -alias YOUR_KEY_ALIAS
# Compare "SHA1:" to Play Console → App signing → Upload key certificate.

storeFile=app/play-upload.keystore
storePassword=REPLACE_ME
keyAlias=REPLACE_ME
keyPassword=REPLACE_ME
